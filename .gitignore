node_modules/
dist/
.venv/
# Prefer pnpm; ignore npm lockfile
package-lock.json

# Local-only dev helpers (install, verify, reinstall/uninstall). Repo keeps only
# scripts/sync-plugin-version.js under scripts/ for prepare/CI. Ignore anything
# extra under dev-scripts/; tracked files are re-included below.
scripts/*
!scripts/sync-plugin-version.js
dev-scripts/*
!dev-scripts/README.md
!dev-scripts/install-aws-cli.sh
!dev-scripts/install-jq.sh
!dev-scripts/install-pnpm.sh
!dev-scripts/reinstall.sh
!dev-scripts/uninstall.sh
!dev-scripts/verify-dev-tools.sh

# Local examples and experiments (not versioned), except checked-in runbooks
examples/*
!examples/mnemospark-agent-and-skill/
examples/mnemospark-agent-and-skill/*
!examples/mnemospark-agent-and-skill/mnemospark-agent-runbook.md

# Python / uv
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.tsbuildinfo
.DS_Store
.playwright-mcp/

# Env and secrets
.env
.env.*
.env.local

# Build / test artifacts
.tmp-e2e/
coverage/

# IDE / editor
.idea/
*.swp
*.swo
# Cursor: ignore local/editor state; commit shared rules under .cursor/rules/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.vscode/

# Test / test artifacts
test-files/