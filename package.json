{
  "name": "mnemospark",
  "version": "0.6.0",
  "description": "mnemospark is an OpenClaw plugin that gives agentic systems instant, secure access to cloud storage, compute, and proprietary datasets paid via x402 with USDC on Base. Wallet and go.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mnemospark": "./dist/cli.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skills",
    "scripts",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "test:install-check": "node test/install-check.mjs",
    "test:slash-commands": "node test/test-mnemospark-slash-commands.mjs",
    "prepare": "node scripts/sync-plugin-version.js && husky"
  },
  "keywords": [
    "openclaw",
    "mnemospark",
    "storage",
    "wallet",
    "x402",
    "usdc",
    "base",
    "payment",
    "cloud-storage",
    "plugin",
    "agentic-commerce"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:pawlsclick/mnemospark.git"
  },
  "homepage": "https://github.com/pawlsclick/mnemospark#readme",
  "bugs": {
    "url": "https://github.com/pawlsclick/mnemospark/issues"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "viem": "^2.39.3"
  },
  "peerDependencies": {
    "openclaw": ">=2025.1.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openclaw": "latest",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
